# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5-mini
OPENAI_JUDGE_MODEL=gpt-5-mini
OPENAI_JUDGE_TEMPERATURE=0.0

# AWS Configuration
AWS_REGION=us-east-1
ENDPOINT_URL=http://localhost:5000  # Uncomment and set if using Moto/LocalStack for local testing
RETRY_MODE=standard

# PostgreSQL Database Configuration (Tracing)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=chatbotDb
POSTGRES_USER=jose
POSTGRES_PASSWORD=myTheOrganizationPassword
